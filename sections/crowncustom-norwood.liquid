<div
  class="crowncustom-norwood-section"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
  {{ section.shopify_attributes }}
>
  {%- unless section.settings.full_width -%}
    <div class="container container--not-mobile fully-spaced-row--medium fully-spaced-row--not-mobile">
  {%- endunless -%}
    {%- liquid
      assign cta_url = section.settings.cta_url | strip
      if section.settings.cta_page != blank
        assign cta_page = pages[section.settings.cta_page]
        if cta_page.url != blank
          assign cta_url = cta_page.url
        endif
      endif
      if cta_url == blank
        assign cta_url = '/pages/custom-hair-system'
      endif
    -%}
    <div
      id="crowncustom-norwood-{{ section.id }}"
      data-crowncustom-norwood
      data-api-base="{{ section.settings.api_base | escape }}"
      data-shop="{{ shop.permanent_domain | escape }}"
      data-cta-url="{{ cta_url | escape }}"
    ></div>
  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

<script src="{{ 'crowncustom-norwood.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CrownCustom Norwood scan",
  "settings": [
    {
      "type": "text",
      "id": "api_base",
      "label": "API base path",
      "default": "/apps/crowncustom/api"
    },
    {
      "type": "page",
      "id": "cta_page",
      "label": "Custom order page (CTA destination)",
      "info": "After the scan, users go here with ?norwood=…&from=norwood-scan. Prefer this over manual URL."
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Custom order URL (fallback)",
      "default": "/pages/custom-hair-system",
      "info": "Used when no page is selected above."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full page width",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank for transparent"
    }
  ],
  "presets": [
    {
      "name": "CrownCustom Norwood scan"
    }
  ]
}
{% endschema %}
