<div
  class="crowncustom-customizer-section"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
  {{ section.shopify_attributes }}
>
  {%- unless section.settings.full_width -%}
    <div class="container container--not-mobile fully-spaced-row--medium fully-spaced-row--not-mobile">
  {%- endunless -%}
    <div
      id="crowncustom-customizer-{{ section.id }}"
      data-crowncustom-customizer
      data-api-base="{{ section.settings.api_base | escape }}"
      data-shop="{{ shop.permanent_domain | escape }}"
    ></div>
  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

<script src="{{ 'crowncustom-customizer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CrownCustom customizer",
  "settings": [
    {
      "type": "text",
      "id": "api_base",
      "label": "API base path",
      "default": "/apps/crowncustom/api"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full page width",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank for transparent"
    }
  ],
  "presets": [
    {
      "name": "CrownCustom customizer"
    }
  ]
}
{% endschema %}